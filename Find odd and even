import java.util.*;

  public class Main {
    public static void main(String[] args) {
      int[] arr={1,2,3,4,5,6,};
      int[] odd=new int[arr.length];
      int[] even=new int[arr.length];
      int e=0; o=0;
      for(int i=0;i<arr.length;i++){
        if(arr[i]%2==0){
          odd[e]=arr[i];
          e++;
        }else{
          even[o]=arr[i];
          o++;
        }
        }
        System.out.println("Odd number:");
        System.out.println(Arrays.toString(Arrays.copyof(even,e)));
        System.out.println("Even Number:");
        System.out.println(Arrays.toString(Arrays.copyof(odd,o)));
    }
      }
